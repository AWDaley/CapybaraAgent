{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tal-mobile-observation-0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "run_id", "tool_id", "tool_version", "observation_type", "trust_class", "source_refs", "content_hash", "created_at"],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^observation:[a-z0-9._-]+$"},
    "run_id": {"type": "string", "pattern": "^run:[a-z0-9._-]+$"},
    "tool_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "tool_version": {"const": "1.0.0"},
    "observation_type": {"enum": ["document_text_span", "image_ocr_result", "evidence_bundle", "local_draft_committed", "local_task_list_committed", "verified_answer_package", "verified_summary_package"]},
    "trust_class": {"enum": ["reported", "observed", "verified", "inferred", "conflicted"]},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
