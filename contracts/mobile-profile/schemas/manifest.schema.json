{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tal-manifest-0.3.0",
  "title": "Tervoro Mobile TAL Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["tal_version", "grammar_id", "schema_id", "domain_pack", "request", "scope", "goal", "unknowns", "requirements", "constraints", "requested_capabilities", "prohibited_actions", "success_conditions", "fallbacks", "output_contract", "integrity"],
  "properties": {
    "tal_version": {"const": "0.3.0"},
    "grammar_id": {"const": "tal-core-0.3.0"},
    "schema_id": {"const": "tal-manifest-0.3.0"},
    "domain_pack": {"const": "tal.mobile.private_assistant-0.1.0"},
    "request": {"$ref": "#/$defs/request"},
    "scope": {"$ref": "#/$defs/scope"},
    "goal": {"$ref": "#/$defs/goal"},
    "reported_facts": {"type": "array", "items": {"$ref": "#/$defs/reportedFact"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}},
    "constraints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/constraint"}},
    "preferences": {"type": "array", "items": {"$ref": "#/$defs/preference"}},
    "requested_capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "prohibited_actions": {"type": "array", "items": {"$ref": "#/$defs/prohibition"}},
    "success_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/successCondition"}},
    "fallbacks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fallback"}},
    "output_contract": {"$ref": "#/$defs/outputContract"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-z][a-z0-9._:-]*$"},
    "request": {"type": "object", "additionalProperties": false, "required": ["request_id", "submitted_by", "submitted_at", "channel"], "properties": {"request_id": {"$ref": "#/$defs/id"}, "submitted_by": {"$ref": "#/$defs/id"}, "submitted_at": {"type": "string", "format": "date-time"}, "channel": {"const": "mobile"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["scope_id", "organization_ref", "target_refs", "entity_declarations", "timezone"], "properties": {"scope_id": {"$ref": "#/$defs/id"}, "organization_ref": {"$ref": "#/$defs/id"}, "target_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "entity_declarations": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "timezone": {"type": "string", "minLength": 1, "maxLength": 64}}},
    "entity": {"type": "object", "additionalProperties": false, "required": ["entity_type", "entity_ref"], "properties": {"entity_type": {"enum": ["document", "image", "draft", "note", "task", "user"]}, "entity_ref": {"$ref": "#/$defs/id"}}},
    "goal": {"type": "object", "additionalProperties": false, "required": ["goal_id", "actor_ref", "owner_ref", "target_ref", "outcome_id"], "properties": {"goal_id": {"$ref": "#/$defs/id"}, "actor_ref": {"$ref": "#/$defs/id"}, "owner_ref": {"$ref": "#/$defs/id"}, "target_ref": {"$ref": "#/$defs/id"}, "outcome_id": {"enum": ["document.answer_with_evidence", "document.summary", "task.extract_local", "draft.create_local"]}}},
    "reportedFact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "subject_ref", "field_id", "value"], "properties": {"fact_id": {"$ref": "#/$defs/id"}, "subject_ref": {"$ref": "#/$defs/id"}, "field_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "maxLength": 4096}}},
    "unknown": {"type": "object", "additionalProperties": false, "required": ["id", "subject_ref", "field_id", "blocking"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_ref": {"$ref": "#/$defs/id"}, "field_id": {"$ref": "#/$defs/id"}, "blocking": {"type": "boolean"}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "rule_id", "verifier_id", "target_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "rule_id": {"$ref": "#/$defs/id"}, "verifier_id": {"$ref": "#/$defs/id"}, "target_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}}},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "maximum"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["model_calls", "tool_calls", "external_actions", "time_millis", "context_tokens", "output_tokens", "storage_bytes"]}, "maximum": {"type": "integer", "minimum": 0, "maximum": 9000000000}}},
    "preference": {"type": "object", "additionalProperties": false, "required": ["id", "criterion", "rank"], "properties": {"id": {"$ref": "#/$defs/id"}, "criterion": {"enum": ["minimize_data_exposure", "minimize_latency", "minimize_battery"]}, "rank": {"type": "integer", "minimum": 1, "maximum": 16}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["id", "action_id", "target_ref"], "properties": {"id": {"$ref": "#/$defs/id"}, "action_id": {"enum": ["document.selected.read", "image.selected.inspect", "vault.search", "draft.create", "note.create", "task.create_local"]}, "target_ref": {"$ref": "#/$defs/id"}}},
    "prohibition": {"type": "object", "additionalProperties": false, "required": ["id", "action_id", "target_ref"], "properties": {"id": {"$ref": "#/$defs/id"}, "action_id": {"enum": ["cloud_model.request", "message.send", "calendar.event.create"]}, "target_ref": {"$ref": "#/$defs/id"}}},
    "successCondition": {"type": "object", "additionalProperties": false, "required": ["id", "condition_id", "terminal_outcome", "verification_mode", "required_observation_types"], "properties": {"id": {"$ref": "#/$defs/id"}, "condition_id": {"enum": ["answer_package_released", "summary_package_released", "local_draft_committed", "task_list_committed"]}, "terminal_outcome": {"enum": ["answer_delivered", "summary_delivered", "draft_saved", "task_list_saved"]}, "verification_mode": {"const": "deterministic_validator"}, "required_observation_types": {"type": "array", "minItems": 1, "items": {"enum": ["verified_answer_package", "verified_summary_package", "local_draft_committed", "local_task_list_committed"]}}}},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["id", "trigger", "terminal_outcome"], "properties": {"id": {"$ref": "#/$defs/id"}, "trigger": {"enum": ["information_timeout", "budget_exceeded", "capability_denied", "model_unavailable"]}, "terminal_outcome": {"enum": ["escalated", "cancelled"]}}},
    "outputContract": {"type": "object", "additionalProperties": false, "required": ["output_type", "required_fields", "format", "destination"], "properties": {"output_type": {"enum": ["answer_package", "summary_package", "draft", "task_list"]}, "required_fields": {"type": "array", "minItems": 1, "items": {"enum": ["outcome", "evidence_summary", "remaining_unknowns", "audit_reference", "summary", "tasks", "content_hash"]}}, "format": {"const": "mobile_ui"}, "destination": {"const": "local_ui"}}},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["canonicalization", "compiler_version", "manifest_version", "manifest_hash"], "properties": {"canonicalization": {"const": "tal-json-c14n-0.2"}, "compiler_version": {"const": "tal-mobile-compiler-0.1.0"}, "manifest_version": {"type": "integer", "const": 1}, "manifest_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}
  }
}
