{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tal-mobile-capability-0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "action_id", "resource_type", "target_refs", "field_allowlist", "purpose_id", "approval_level", "expires_when"],
  "properties": {
    "capability_id": {"type": "string", "pattern": "^cap:[a-z0-9._-]+$"},
    "action_id": {"enum": ["document.selected.read", "image.selected.inspect", "vault.search", "draft.create", "note.create", "task.create_local"]},
    "resource_type": {"enum": ["document", "image", "vault", "draft", "note", "task"]},
    "target_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "field_allowlist": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "time_scope": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "purpose_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "approval_level": {"enum": ["none", "action_preview", "device_credential", "biometric_strong"]},
    "expires_when": {"enum": ["goal_terminal", "approval_expiry", "run_cancelled"]}
  }
}
