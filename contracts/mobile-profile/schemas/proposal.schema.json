{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tal-mobile-proposal-0.1.0",
  "oneOf": [
    {"$ref": "#/$defs/requestTool"},
    {"$ref": "#/$defs/proposeCompletion"},
    {"$ref": "#/$defs/escalate"}
  ],
  "$defs": {
    "binding": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "goal_id", "manifest_hash", "manifest_version", "state_version"], "properties": {"proposal_id": {"type": "string", "pattern": "^proposal:[a-z0-9._-]+$"}, "goal_id": {"type": "string", "minLength": 1}, "manifest_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "manifest_version": {"const": 1}, "state_version": {"type": "integer", "minimum": 0}}},
    "requestTool": {"allOf": [{"$ref": "#/$defs/binding"}, {"type": "object", "additionalProperties": false, "required": ["kind", "proposal_id", "goal_id", "manifest_hash", "manifest_version", "state_version", "tool_id", "tool_version", "arguments", "purpose", "evidence_refs", "expected_observation_type"], "properties": {"kind": {"const": "request_tool"}, "proposal_id": {"type": "string", "pattern": "^proposal:[a-z0-9._-]+$"}, "goal_id": {"type": "string"}, "manifest_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "manifest_version": {"const": 1}, "state_version": {"type": "integer", "minimum": 0}, "tool_id": {"enum": ["document.selected.read", "image.selected.inspect", "vault.search", "draft.create", "note.create", "task.create_local"]}, "tool_version": {"const": "1.0.0"}, "arguments": {"type": "object", "additionalProperties": false, "properties": {"query_ref": {"type": "string"}, "source_refs": {"type": "array", "items": {"type": "string"}}, "maximum_items": {"type": "integer", "minimum": 1, "maximum": 12}}, "required": []}, "purpose": {"type": "string", "minLength": 1, "maxLength": 512}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "expected_observation_type": {"type": "string", "minLength": 1, "maxLength": 160}}}]},
    "proposeCompletion": {"allOf": [{"$ref": "#/$defs/binding"}, {"type": "object", "additionalProperties": false, "required": ["kind", "proposal_id", "goal_id", "manifest_hash", "manifest_version", "state_version", "success_condition_ref", "evidence_refs", "reason"], "properties": {"kind": {"const": "propose_completion"}, "proposal_id": {"type": "string", "pattern": "^proposal:[a-z0-9._-]+$"}, "goal_id": {"type": "string"}, "manifest_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "manifest_version": {"const": 1}, "state_version": {"type": "integer", "minimum": 0}, "success_condition_ref": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}}}]},
    "escalate": {"allOf": [{"$ref": "#/$defs/binding"}, {"type": "object", "additionalProperties": false, "required": ["kind", "proposal_id", "goal_id", "manifest_hash", "manifest_version", "state_version", "reason_code", "safe_context"], "properties": {"kind": {"const": "escalate"}, "proposal_id": {"type": "string", "pattern": "^proposal:[a-z0-9._-]+$"}, "goal_id": {"type": "string"}, "manifest_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "manifest_version": {"const": 1}, "state_version": {"type": "integer", "minimum": 0}, "reason_code": {"type": "string", "minLength": 1}, "safe_context": {"type": "string", "maxLength": 1024}}}]}
  }
}
