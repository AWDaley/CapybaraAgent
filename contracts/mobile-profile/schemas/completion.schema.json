{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tal-mobile-completion-0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["completion_id", "run_id", "success_condition_ref", "required_observation_refs", "output_contract_hash", "verified_at", "outcome"],
  "properties": {
    "completion_id": {"type": "string", "pattern": "^completion:[a-z0-9._-]+$"},
    "run_id": {"type": "string", "pattern": "^run:[a-z0-9._-]+$"},
    "success_condition_ref": {"type": "string", "minLength": 1, "maxLength": 160},
    "required_observation_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "output_contract_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "verified_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["answer_delivered", "summary_delivered", "draft_saved", "task_list_saved"]}
  }
}
